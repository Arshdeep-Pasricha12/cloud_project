# Frontend Environment Configuration
# IMPORTANT: Never commit actual values or secrets to source control.
# SECURITY RULE: Never place AWS Access Keys or Secrets in client-side Vite environment variables.
# Copy this file to .env and configure real endpoints once AWS resources are deployed.

# AWS Region hosting the serverless stack (e.g., us-east-1)
VITE_AWS_REGION=your-aws-region-here

# Milestone 2: Dedicated Presigned S3 Upload API Endpoint
# URL to POST /documents/upload-url (Lambda create-upload via API Gateway or local test bridge)
# Example: https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod/documents/upload-url
VITE_UPLOAD_API_URL=https://your-api-id.execute-api.your-aws-region.amazonaws.com/prod/documents/upload-url

# Amazon API Gateway Base REST API URL (Future Milestone 3)
VITE_API_BASE_URL=https://your-api-id.execute-api.your-aws-region.amazonaws.com/prod

# Amazon Cognito Authentication (Future Milestone 1)
VITE_COGNITO_USER_POOL_ID=your-cognito-user-pool-id
VITE_COGNITO_CLIENT_ID=your-cognito-app-client-id

# Amazon S3 Document Bucket (Informational - presigned URLs embed target bucket automatically)
VITE_S3_DOCUMENT_BUCKET=your-document-storage-bucket-name

# Application Environment (development | production)
VITE_APP_ENV=development
