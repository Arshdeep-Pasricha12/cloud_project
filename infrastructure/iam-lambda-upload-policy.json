{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowS3PresignedPutOnUploadsPrefix",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::${DOCUMENTS_BUCKET_NAME}/uploads/*"
    },
    {
      "Sid": "AllowCloudWatchLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:*:*:log-group:/aws/lambda/create-upload:*"
    }
  ]
}
